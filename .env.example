# Copy to .env for local overrides (never commit .env).
# Performance-tuning knobs read by local/docker-compose.yml
HIKARI_MAX_POOL=20
CACHE_ENABLED=true
JPA_OPEN_IN_VIEW=false
JAVA_TOOL_OPTIONS=

# Demo / test endpoints
ACCOUNTS_URL=http://localhost:8081
TRANSFER_URL=http://localhost:8082
AUDIT_URL=http://localhost:8083
CONSOLE_URL=http://localhost:3000

# AWS (Phase 2 only)
AWS_PROFILE=core-banking-ledger-deployer
AWS_REGION=ap-southeast-2
