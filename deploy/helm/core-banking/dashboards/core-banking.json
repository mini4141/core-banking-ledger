{
  "uid": "core-banking",
  "title": "Core Banking Ledger",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests per second (by service)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{application}}", "expr": "sum by (application) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1m]))" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Latency p95 / p99 - POST /transfers",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"transfer-service\", uri=\"/transfers\", method=\"POST\"}[1m])))" },
        { "refId": "B", "legendFormat": "p99", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"transfer-service\", uri=\"/transfers\", method=\"POST\"}[1m])))" }
      ]
    },
    {
      "id": 3, "type": "stat", "title": "Circuit breaker state (accounts)",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "textMode": "name" },
      "fieldConfig": { "defaults": { "mappings": [] } },
      "targets": [{ "refId": "A", "legendFormat": "{{state}}", "expr": "resilience4j_circuitbreaker_state{application=\"transfer-service\", name=\"accounts\"} == 1" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Kafka consumer lag (audit-service)",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "max lag", "expr": "max(kafka_consumer_fetch_manager_records_lag_max{application=\"audit-service\"})" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "HikariCP connections",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "{{application}} active", "expr": "hikaricp_connections_active" },
        { "refId": "B", "legendFormat": "{{application}} pending", "expr": "hikaricp_connections_pending" }
      ]
    }
  ]
}
